# Example Nginx routes for the campus-market dev environment.
# Keep admin routes split by service instead of forwarding all /admin/** to one backend.

upstream auth_service {
    server auth-service:8081;
}

upstream user_service {
    server user-service:8082;
}

upstream item_service {
    server item-service:8083;
}

upstream trade_service {
    server trade-service:8084;
}

upstream notice_service {
    server notice-service:8088;
}

upstream chat_service {
    server chat-service:8085;
}

upstream review_service {
    server review-service:8086;
}

upstream file_service {
    server file-service:8087;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 20m;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    etag on;

    gzip on;
    gzip_min_length 1024;
    gzip_types application/json text/css application/javascript application/xml image/svg+xml;

    open_file_cache max=10000 inactive=60s;
    open_file_cache_valid 120s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;

    location /auth/ {
        proxy_pass http://auth_service;
        include /etc/nginx/proxy_params;
    }

    location /users/ {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location = /reports {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location /reports/ {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location = /admin/reports {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location /admin/reports/ {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location /admin/users/ {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location /admin/items/ {
        proxy_pass http://user_service;
        include /etc/nginx/proxy_params;
    }

    location = /admin/pickup-points {
        proxy_pass http://trade_service;
        include /etc/nginx/proxy_params;
    }

    location /admin/pickup-points/ {
        proxy_pass http://trade_service;
        include /etc/nginx/proxy_params;
    }

    location = /pickup-points {
        proxy_pass http://trade_service;
        include /etc/nginx/proxy_params;
    }

    location /pickup-points/ {
        proxy_pass http://trade_service;
        include /etc/nginx/proxy_params;
    }

    location /items/ {
        proxy_pass http://item_service;
        include /etc/nginx/proxy_params;
    }

    location /recommend/ {
        proxy_pass http://item_service;
        include /etc/nginx/proxy_params;
    }

    location = /locations {
        proxy_pass http://item_service;
        include /etc/nginx/proxy_params;
    }

    location /locations/ {
        proxy_pass http://item_service;
        include /etc/nginx/proxy_params;
    }

    location /trades/ {
        proxy_pass http://trade_service;
        include /etc/nginx/proxy_params;
    }

    location /chats/ {
        proxy_pass http://chat_service;
        include /etc/nginx/proxy_params;
    }

    location /reviews/ {
        proxy_pass http://review_service;
        include /etc/nginx/proxy_params;
    }

    location /files/ {
        proxy_pass http://file_service;
        include /etc/nginx/proxy_params;
    }

    location = /notifications {
        proxy_pass http://notice_service;
        include /etc/nginx/proxy_params;
    }

    location = /notifications/read-all {
        proxy_pass http://notice_service;
        include /etc/nginx/proxy_params;
    }

    location /notifications/ {
        proxy_pass http://notice_service;
        include /etc/nginx/proxy_params;
    }

    location /uploads/ {
        alias /opt/campus-market/dev/uploads/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}
